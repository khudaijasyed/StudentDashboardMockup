#!/usr/bin/env bash
set -euo pipefail

# Refresh the Payload admin importMap before starting dev. This requires
# `buildFigmaConfig` to succeed, which in turn needs FIGMA_CONTENT_API_*
# env vars (set by the Make sandbox once a Payload backend has been
# provisioned for this file). Until that happens we tolerate failure: the
# /admin route can't render anyway without the backend, and a stale map
# is fine for the (frontend) routes the user sees pre-connect. After the
# backend connects and the workload restarts, this will succeed and pick
# up any new components the alpha @payloadcms/figma exposes.
pnpm generate:importmap || echo "[dev] generate:importmap skipped (Payload backend not connected yet)"

pnpm run dev
